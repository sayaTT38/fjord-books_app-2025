<div id="<%= dom_id comment %>">

  <p>
    <strong><%= Comment.human_attribute_name(:body) + ':' %></strong>
    <%= comment.body %>
  </p>

  <p>
    <strong><%= Comment.human_attribute_name(:posted_by) + ':' %></strong>
    <%= comment.user.display_name %>
  </p>

  <p>
    <strong><%= Comment.human_attribute_name(:created_at) + ':' %></strong>
    <%= l comment.created_at, format: :long %>
  </p>

  <% if comment.user == current_user %>
    <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase),
      [ comment.commentable , comment ],
      method: :delete %>
  <% end %>
</div>
